@page "/login"

<PageTitle>Login</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title mb-4">Login</h3>

                @if (Error is not null)
                {
                    <div class="alert alert-danger">Incorrect password.</div>
                }

                <form method="post" action="/auth/login">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" type="email" name="email"
                               value="@Email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input class="form-control" type="password" name="password"
                               required />
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Login</button>
                </form>

                <p class="mt-3 text-center small">
                    No account? <a href="/register">Register</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    // On a failed login the endpoint redirects back here with ?email=...&error=1.
    // Email pre-fills from the query param; password renders empty (never echoed).
    [SupplyParameterFromQuery] private string? Email { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
}
