@rendermode InteractiveServer

<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="/">🎬 Cinema</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav me-auto">

            <AuthorizeView>
                <Authorized>
                    <li class="nav-item">
                        <a class="nav-link" href="/my-tickets">My Tickets</a>
                    </li>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Cashier,Admin">
                <Authorized>
                    <li class="nav-item">
                        <a class="nav-link" href="/cashier/confirm">Confirm Ticket</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cashier/sell">Sell Ticket</a>
                    </li>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/films">Manage Films</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/screenings">Manage Screenings</a>
                    </li>
                </Authorized>
            </AuthorizeView>
        </ul>

        <ul class="navbar-nav ms-auto">
            <AuthorizeView>
                <Authorized>
                    <li class="nav-item">
                        <a class="nav-link" href="/profile">
                            @context.User.Identity?.Name
                        </a>
                    </li>
                    <li class="nav-item">
                        <form method="post" action="/auth/logout">
                            <button class="btn btn-link nav-link" type="submit">Logout</button>
                        </form>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li class="nav-item">
                        <a class="nav-link" href="/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/register">Register</a>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </div>
</nav>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
